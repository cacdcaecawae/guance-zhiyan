# Copy to server/.env. Never commit the real key.
DEEPSEEK_API_KEY=
# DSH 0.1.7-rc.1 uses the Anthropic-compatible Messages API.
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
# Search uses its own endpoint, including /v1.
DEEPSEEK_SEARCH_BASE_URL=https://api.deepseek.com/anthropic/v1
# 千问 AI 平台按量付费密钥；模型在网页选择，两家均使用 DeepSeek。
QIANWEN_API_KEY=
QIANWEN_BASE_URL=https://maas.qianwenaiapi.com/apps/anthropic
# pnpm chat forces loopback and same origin; HOST / APP_ORIGIN are used by ordinary server startup.
APP_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=server/data

# Optional existing outbound proxy; leave blank for direct networking.
HTTP_PROXY=
HTTPS_PROXY=

# Optional isolated Bash/file execution; leave URL blank to keep chat without Bash.
SANDBOX_URL=
SANDBOX_API_KEY=
SANDBOX_IMAGE=guance-workspace:1
SANDBOX_CAPACITY=4
SANDBOX_CPU=1
SANDBOX_MEMORY=1Gi
SANDBOX_IDLE_SECONDS=300
# Comma-separated additional denied IPs/CIDRs, including the deployment host's public IP.
SANDBOX_DENY_CIDRS=
