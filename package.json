{
  "name": "guance-zhiyan",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "chat": "pnpm build && node --env-file-if-exists=server/.env server/index.ts --local",
    "dev:server": "node --env-file-if-exists=server/.env --watch server/index.ts",
    "start": "node --env-file-if-exists=server/.env server/index.ts",
    "rag": "node --env-file-if-exists=server/.env server/rag-import.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc -p server/tsconfig.json",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run && pnpm test:server",
    "test:server": "node --expose-gc --test --test-isolation=none --test-timeout=30000 server/*.test.ts",
    "test:sandbox": "node --env-file-if-exists=server/.env --test server/sandbox/live.test.ts",
    "test:rag": "node --test server/rag/live.test.ts",
    "test:e2e": "pnpm build && playwright test",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@alibaba-group/opensandbox": "1.1.0",
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.1",
    "@deepseek-ai/dsh-agent-loop": "0.1.7-rc.1",
    "@deepseek-ai/dsh-fs": "0.1.7-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.1.7-rc.1",
    "@deepseek-ai/dsh-http-proxy": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm": "0.1.7-rc.1",
    "@deepseek-ai/dsh-llm-deepseek": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.1.7-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.1.7-rc.1",
    "@deepseek-ai/dsh-shell": "0.1.7-rc.1",
    "@deepseek-ai/dsh-shell-env": "0.1.7-rc.1",
    "@deepseek-ai/dsh-system-prompt": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-bash": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-fs": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tool-web": "0.1.7-rc.1",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web-fetch-http": "0.1.7-rc.1",
    "@deepseek-ai/dsh-web-search-deepseek": "0.1.7-rc.1",
    "@fontsource-variable/noto-serif-sc": "^5.3.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx": "9.5.1",
    "exceljs": "4.4.0",
    "fast-xml-parser": "5.5.8",
    "jszip": "3.10.1",
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "10.1.0",
    "react-router": "^8.4.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.1.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
