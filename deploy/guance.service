# Linux 服务器开机自启（systemd）模板。不要改仓库里的这份（工作区有改动时 deploy/guance.sh update 会拒绝更新），
# 在仓库根目录以运行服务的账号执行，安装时替换仓库目录与账号：
#   sed "s#/srv/guance#$PWD#g; s#^User=guance#User=$USER#" deploy/guance.service | sudo tee /etc/systemd/system/guance.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now guance   # 之后用 systemctl status / stop / restart guance
# 由 systemd 管理时不要再手动执行 deploy/guance.sh run。node 不在 /usr/bin 等系统目录时，在 deploy/.env 设置 PATH。
[Unit]
Description=管策智研（Qdrant、向量服务与网站）
After=network-online.target docker.service
Wants=network-online.target

[Service]
User=guance
WorkingDirectory=/srv/guance
ExecStart=/srv/guance/deploy/guance.sh run
Restart=on-failure
RestartSec=10
TimeoutStopSec=40

[Install]
WantedBy=multi-user.target
